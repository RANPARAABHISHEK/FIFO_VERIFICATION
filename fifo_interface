interface fifo_if #(
    parameter data_width = 8
)(
    input logic clk
);

    logic reset;

    logic wr_en;
    logic rd_en;

    logic [data_width-1:0] data_in;
    logic [data_width-1:0] data_out;

    logic full;
    logic empty;

    clocking write_drv_cb @(negedge clk);

        output wr_en;
        output data_in;

        input full;

    endclocking

    clocking write_mon_cb @(posedge clk);

        input wr_en;
        input data_in;
        input full;

    endclocking


    clocking read_drv_cb @(negedge clk);

        output rd_en;

        input empty;

    endclocking


    clocking read_mon_cb @(posedge clk);

    input rd_en;
    input #0 data_out;
    input empty;

endclocking

    modport WRITE_DRV_MP (
        clocking write_drv_cb
    );

    modport WRITE_MON_MP (
        clocking write_mon_cb
    );

    modport READ_DRV_MP (
        clocking read_drv_cb
    );

    modport READ_MON_MP (
        clocking read_mon_cb
    );

endinterface
