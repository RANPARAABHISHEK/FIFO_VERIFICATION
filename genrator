class fifo_gen;

    fifo_trans gen_trans;

    mailbox #(fifo_trans) gen2wr;

    mailbox #(fifo_trans) gen2rd;

    mailbox #(fifo_trans) gen2cov;

    int no_of_transaction;


    function new(
        mailbox #(fifo_trans) gen2wr,
        mailbox #(fifo_trans) gen2rd,
        mailbox #(fifo_trans) gen2cov,
        int no_of_transaction
    );

        this.gen2wr  = gen2wr;

        this.gen2rd  = gen2rd;

        this.gen2cov = gen2cov;

        this.no_of_transaction = no_of_transaction;

    endfunction


    task start();

        fork

            begin

                for (int i = 0; i < no_of_transaction; i++) begin

                    gen_trans = new();


         
                    case (i)

                        // 00
                        0: begin

                            assert(gen_trans.randomize() with {
                                wr_en == 0;
                                rd_en == 0;
                            })
                            else
                                $fatal("Randomization failed for 00");

                        end


                        // 01
                        1: begin

                            assert(gen_trans.randomize() with {
                                wr_en == 0;
                                rd_en == 1;
                            })
                            else
                                $fatal("Randomization failed for 01");

                        end


                        // 10
                        2: begin

                            assert(gen_trans.randomize() with {
                                wr_en == 1;
                                rd_en == 0;
                            })
                            else
                                $fatal("Randomization failed for 10");

                        end


                        // 11
                        3: begin

                            assert(gen_trans.randomize() with {
                                wr_en == 1;
                                rd_en == 1;
                            })
                            else
                                $fatal("Randomization failed for 11");

                        end


                        //==================================================
                        // REMAINING TRANSACTIONS RANDOM
                        //==================================================

                        default: begin

                            assert(gen_trans.randomize())
                            else
                                $fatal("Randomization failed");

                        end

                    endcase


                    $display(
                        "GENERATOR : Transaction %0d -> wr_en=%0d rd_en=%0d",
                        i,
                        gen_trans.wr_en,
                        gen_trans.rd_en
                    );


                    gen2wr.put(gen_trans.copy());

                    gen2rd.put(gen_trans.copy());

                    gen2cov.put(gen_trans.copy());

                end


                $display(
                    "\nGENERATOR : %0d transactions generated\n",
                    no_of_transaction
                );

            end

        join_none

    endtask

endclass
