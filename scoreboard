class fifo_sb;

    mailbox #(fifo_trans) rfm2sb;
    mailbox #(fifo_trans) mon2sb;

    fifo_trans expected;
    fifo_trans actual;

    virtual fifo_if.WRITE_MON_MP wr_mon_if;
    virtual fifo_if.READ_MON_MP  rd_mon_if;



    bit cov_wr_en;
    bit cov_rd_en;
    bit cov_full;
    bit cov_empty;


    int pass_count = 0;
    int fail_count = 0;


    covergroup fifo_cg;
cp_write : coverpoint cov_wr_en {
    bins write    = {1};
    bins no_write = {0};
}

cp_read : coverpoint cov_rd_en {
    bins read    = {1};
    bins no_read = {0};
}

cp_empty : coverpoint cov_empty {
    bins empty     = {1};
    bins not_empty = {0};
}

cp_full : coverpoint cov_full {
    bins full     = {1};
    bins not_full = {0};
}

cp_operation : cross cov_wr_en, cov_rd_en;

read_empty : cross cov_rd_en, cov_empty;

write_full : cross cov_wr_en, cov_full;

operation_state :
    cross cov_wr_en,
          cov_rd_en,
          cov_empty,
          cov_full {

    ignore_bins empty_full =
        binsof(cov_empty) intersect {1} &&
        binsof(cov_full)  intersect {1};
}
    endgroup



    function new(
        mailbox #(fifo_trans) rfm2sb,
        mailbox #(fifo_trans) mon2sb,

        virtual fifo_if.WRITE_MON_MP wr_mon_if,
        virtual fifo_if.READ_MON_MP  rd_mon_if
    );

        this.rfm2sb = rfm2sb;
        this.mon2sb = mon2sb;

        this.wr_mon_if = wr_mon_if;
        this.rd_mon_if = rd_mon_if;

        fifo_cg = new();

    endfunction


    task start();

        fork


            begin

                forever begin

                    rfm2sb.get(expected);

                    mon2sb.get(actual);

                    check(expected, actual);

                end

            end


            begin

                forever begin

                    @(wr_mon_if.write_mon_cb);

                    cov_wr_en =
                        wr_mon_if.write_mon_cb.wr_en;

                    cov_full =
                        wr_mon_if.write_mon_cb.full;

                    cov_rd_en =
                        rd_mon_if.read_mon_cb.rd_en;

                    cov_empty =
                        rd_mon_if.read_mon_cb.empty;

                    fifo_cg.sample();


                    $display(
                        "COVERAGE : WR=%0d RD=%0d FULL=%0d EMPTY=%0d",
                        cov_wr_en,
                        cov_rd_en,
                        cov_full,
                        cov_empty
                    );

                end

            end

        join_none

    endtask


    task check(
        fifo_trans expected,
        fifo_trans actual
    );

        if (expected.data_out == actual.data_out) begin

            pass_count++;

            $display(
                "SCOREBOARD PASS : Expected = %0d  Actual = %0d",
                expected.data_out,
                actual.data_out
            );

        end

        else begin

            fail_count++;

            $display(
                "SCOREBOARD FAIL : Expected = %0d  Actual = %0d",
                expected.data_out,
                actual.data_out
            );

        end

    endtask


    
    function void report();

        $display("\n============================================");
        $display("             FIFO SCOREBOARD");
        $display("============================================");

        $display("PASS COUNT = %0d", pass_count);
        $display("FAIL COUNT = %0d", fail_count);

        if (fail_count == 0)
            $display("RESULT     = TEST PASSED");
        else
            $display("RESULT     = TEST FAILED");

        $display("--------------------------------------------");

        $display(
            "FUNCTIONAL COVERAGE = %0.2f %%",
            fifo_cg.get_coverage()
        );

        $display("============================================\n");

    endfunction

endclass
