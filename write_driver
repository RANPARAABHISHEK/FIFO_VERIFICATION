class write_drv;

    virtual fifo_if.WRITE_DRV_MP wr_drv_if;

    mailbox #(fifo_trans) gen2wr;

    fifo_trans data2duv;


    function new(
        virtual fifo_if.WRITE_DRV_MP wr_drv_if,
        mailbox #(fifo_trans) gen2wr
    );

        this.wr_drv_if = wr_drv_if;

        this.gen2wr = gen2wr;

    endfunction


    task drive();

        @(wr_drv_if.write_drv_cb);

        wr_drv_if.write_drv_cb.wr_en <= data2duv.wr_en;

        wr_drv_if.write_drv_cb.data_in <= data2duv.data_in;


        @(wr_drv_if.write_drv_cb);

        wr_drv_if.write_drv_cb.wr_en <= 0;

        wr_drv_if.write_drv_cb.data_in <= 0;

    endtask


    task start();

        fork

            forever begin

                gen2wr.get(data2duv);

                drive();

            end

        join_none

    endtask

endclass
